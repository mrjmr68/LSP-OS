# Copy to .env.local. Restart `npm run dev` after changing these.
# Create the Supabase project first — see README.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Project Settings → API → anon public key. Safe for the browser. RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API → service_role. Server only. Never expose this in the browser
# or in a NEXT_PUBLIC_ variable. Not used by the app in M0/M1. Needed later for
# admin scripts and for promoting the first owner if you do it outside the SQL editor.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URI for the one-time data load (docs/IMPORT.md). Not read by the app.
# Supabase → Project Settings → Database → direct connection, port 5432.
# Do not use the transaction pooler (port 6543). Do not commit the real value.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# Invoice email (M5), and the Board "Report / suggest" notice.
# Both must be set or the notice is saved in the database only.
# INVOICE_FROM_EMAIL is accepted when EMAIL_FROM is unset.
# RESEND_API_KEY=
# EMAIL_FROM="Legend Service Pros <invoices@your-domain>"

# Optional. Server only. Drive time for the en-route ETA text.
# Without it, the text uses a straight-line estimate when the property has coordinates,
# and omits minutes when it does not. Maps still opens either way.
# GOOGLE_MAPS_API_KEY=
